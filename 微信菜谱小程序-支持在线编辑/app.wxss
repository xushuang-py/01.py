page {
  background: #fbf7f1;
  color: #2e2925;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view, text, image, scroll-view, input, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 36rpx 48rpx;
}

.muted { color: #8e8379; }
.eyebrow { color: #b35e45; font-size: 22rpx; letter-spacing: 2rpx; }
.serif { font-family: Georgia, "Times New Roman", serif; }

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-title { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.section-link { color: #b35e45; font-size: 24rpx; }

.dish-image { display: block; width: 100%; height: 100%; }

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 99rpx;
  background: #f2e7dc;
  color: #8b5a48;
  font-size: 21rpx;
}
